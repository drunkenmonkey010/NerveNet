# ==================================
# NerveNet Environment Configuration
# ==================================

# Application
APP_ENV=development

# API
API_HOST=0.0.0.0
API_PORT=8000

# Database
DATABASE_URL=postgresql+psycopg://nervenet:change-me@localhost:5432/nervenet

# Logging
LOG_LEVEL=INFO

# Blockchain
BLOCKCHAIN_PROVIDER=local

# Storage
MODEL_STORAGE_PATH=/app/models
DATA_STORAGE_PATH=/app/data

# ------------------------------------------
# PostgreSQL
# ------------------------------------------

POSTGRES_DB=nervenet
POSTGRES_USER=nervenet
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
