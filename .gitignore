# ==============================
# NerveNet Git Ignore
# ==============================

# Environment / secrets
.env
.env.*
!.env.example

# ==============================
# Python
# ==============================

__pycache__/
*.py[cod]
*.pyo
*.pyd

.venv/
venv/
env/

.pytest_cache/
.mypy_cache/
.ruff_cache/

.coverage
htmlcov/

# ==============================
# Node / React
# ==============================

node_modules/
dist/
build/
.next/
.vite/

npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ==============================
# VS Code
# ==============================

.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ==============================
# IDE
# ==============================

.idea/

# ==============================
# Logs
# ==============================

*.log
logs/

# ==============================
# Databases
# ==============================

*.db
*.sqlite
*.sqlite3

# ==============================
# ML artifacts
# ==============================

*.pkl
*.pickle
*.joblib
*.onnx
*.pt
*.pth

# ==============================
# Generated data
# ==============================

data/raw/*
data/processed/*
data/synthetic/*

# Keep directory structure
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/synthetic/.gitkeep

# ==============================
# Temporary files
# ==============================

tmp/
temp/
.cache/

# ==============================
# OS files
# ==============================

.DS_Store
Thumbs.db

# ==============================
# Docker
# ==============================

*.pid